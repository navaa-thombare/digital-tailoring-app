# Copy this file to .env before running the app.
#
# The seeded superadmin password is read only during first database seed.
# Replace this value before distributing a build, then reset the local database.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@local.store
SUPERADMIN_MOBILE=9999999999
SUPERADMIN_FULL_NAME=Default Superadmin
SUPERADMIN_DEFAULT_PASSWORD=ChangeMe@12345

SESSION_TTL_DAYS=7

# Supabase sync configuration.
# Use the anon public key in the Flutter app. Never put service_role here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
